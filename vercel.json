{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/cron-mail", "schedule": "0 14,20 * * *" },
    { "path": "/api/cron-followups", "schedule": "*/5 * * * *" },
    { "path": "/api/cron-maintenance", "schedule": "15 * * * *" },
    { "path": "/api/cron-scorecard", "schedule": "0 14,15 * * 1" },
    { "path": "/api/cron-discovery", "schedule": "37 4,10,16,22 * * *" },
    { "path": "/api/cron-draft", "schedule": "53 5,11,17,23 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/s/:slug", "destination": "/api/site?slug=:slug" },
    { "source": "/sitemap-sites.xml", "destination": "/api/sitemap-sites" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "killswitch.domains" }],
      "destination": "https://sunflowerwebsites.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "killswitch.domains" }],
      "destination": "https://sunflowerwebsites.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "killswitchwebsites.com" }],
      "destination": "https://sunflowerwebsites.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "killswitchwebsites.com" }],
      "destination": "https://sunflowerwebsites.com/:path*",
      "permanent": true
    },
    { "source": "/menu", "destination": "/pricing", "permanent": false },
    { "source": "/mckillswitches", "destination": "/pricing", "permanent": false },
    { "source": "/kitchen", "destination": "/pricing", "permanent": false },
    { "source": "/reserve", "destination": "/pricing", "permanent": false }
  ]
}
